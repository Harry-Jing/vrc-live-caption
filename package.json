{
  "name": "vrc-live-caption",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --build",
    "check": "pnpm check:frontend && pnpm check:rust",
    "check:ci": "pnpm check:frontend && pnpm check:rust:locked",
    "check:frontend": "pnpm format:check && pnpm lint && pnpm test:frontend && pnpm build",
    "check:rust": "cd src-tauri && cargo fmt --all -- --check && cargo check --workspace --all-targets && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:rust:locked": "cd src-tauri && cargo fmt --all -- --check && cargo check --workspace --all-targets --locked && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked",
    "commitlint": "commitlint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:frontend": "vitest run"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "tailwindcss": "^4.3.3",
    "vue": "3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.122",
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/server-renderer": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "20.11.2",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@11.21.0"
}
